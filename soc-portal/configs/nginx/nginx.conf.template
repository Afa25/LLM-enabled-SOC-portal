  server_tokens off;

  # Docker internal DNS
  resolver 127.0.0.11 valid=30s ipv6=off;
  resolver_timeout 5s;

  access_log /var/log/nginx/access.log;

  gzip       on;
  gzip_types text/plain text/css application/json application/javascript text/xml application/xml;

  # Rate limits — portal login page and API only.
  # Tool proxies (Wazuh, Grafana, etc.) are NOT rate-limited here;
  # they generate hundreds of legitimate sub-requests per page load.
  limit_req_zone $binary_remote_addr zone=portal:10m rate=30r/m;
  limit_req_zone $binary_remote_addr zone=api:10m    rate=300r/m;

  # Auth-request cache — validates the portal session token once per minute
  # per unique token instead of on every single sub-request.
  # Key = session cookie + bearer header so each user gets their own cache slot.
  proxy_cache_path /tmp/nginx_auth_cache
                   levels=1:2
                   keys_zone=auth_cache:5m
                   max_size=50m
                   inactive=10m
                   use_temp_path=off;

  # Wazuh admin credentials injected from .env at container startup via envsubst.
  # Set WAZUH_BASIC_AUTH_B64 = base64("admin:<WAZUH_INDEXER_PASSWORD>")
  map $host $wazuh_basic_auth {
    default "Basic ${WAZUH_BASIC_AUTH_B64}";
  }

  # Detect WebSocket upgrade requests so we can set Connection correctly.
  map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
  }

  # ── HTTP → HTTPS redirect ─────────────────────────────────────
  server {
    listen 80;
    server_name _;
    return 301 https://$host$request_uri;
  }

  # ── HTTPS ─────────────────────────────────────────────────────
  server {
    listen 443 ssl;
    server_name _;

    ssl_certificate     /etc/nginx/certs/server.crt;
    ssl_certificate_key /etc/nginx/certs/server.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 10m;

    # Security headers
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Frame-Options           SAMEORIGIN                            always;
    add_header X-Content-Type-Options    nosniff                               always;
    add_header X-XSS-Protection          "1; mode=block"                       always;
    add_header Referrer-Policy           "strict-origin-when-cross-origin"     always;
    add_header Content-Security-Policy   "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' wss:; font-src 'self' data:; frame-ancestors 'none';" always;

    # ─────────────────────────────────────────────────────────────
    # INTERNAL — portal SSO validation (nginx auth_request)
    # Cached per token for 2 minutes so repeated sub-requests from
    # Wazuh / Grafana / OpenCTI don't pound the portal validate endpoint.
    # ─────────────────────────────────────────────────────────────
    location = /auth-check {
      internal;

      proxy_cache            auth_cache;
      proxy_cache_valid      200 2m;
      proxy_cache_key        "$cookie_soc_session$http_authorization";
      proxy_cache_lock       on;
      proxy_ignore_headers   Cache-Control Expires Set-Cookie;

      set $upstream_portal http://soc-portal:4000;
      proxy_pass              $upstream_portal/api/auth/validate;
      proxy_pass_request_body off;
      proxy_set_header        Content-Length   "";
      proxy_set_header        X-Original-URI   $request_uri;
      proxy_read_timeout      5s;
    }

    location @sso_login {
      return 302 /login?next=$request_uri;
    }

    # ── SOC Portal (main app) ──────────────────────────────────
    location / {
      limit_req zone=portal burst=20 nodelay;
      set $upstream_portal http://soc-portal:4000;
      proxy_pass         $upstream_portal;
      proxy_http_version 1.1;
      proxy_set_header   Upgrade           $http_upgrade;
      proxy_set_header   Connection        $connection_upgrade;
      proxy_set_header   Host              $host;
      proxy_set_header   X-Real-IP         $remote_addr;
      proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
      proxy_set_header   X-Forwarded-Proto $scheme;
      proxy_read_timeout 300s;
    }

    # ── API (longer timeout for LLM + SSE) ───────────────────
    location /api/ {
      limit_req zone=api burst=100 nodelay;
      set $upstream_portal http://soc-portal:4000;
      proxy_pass         $upstream_portal;
      proxy_http_version 1.1;
      proxy_set_header   Host              $host;
      proxy_set_header   X-Real-IP         $remote_addr;
      proxy_set_header   X-Forwarded-Proto $scheme;
      proxy_read_timeout 360s;
      proxy_buffering    off;
      proxy_cache        off;
    }

    # ── Grafana ───────────────────────────────────────────────
    # proxy_pass without trailing slash preserves the /grafana/ prefix so
    # Grafana (serve_from_sub_path=true) receives the correct path.
    # WebSocket support is required for Grafana Live (/grafana/api/live/ws).
    location /grafana/ {
      auth_request      /auth-check;
      error_page 401 = @sso_login;

      auth_request_set $grafana_user $upstream_http_x_auth_user;

      set $upstream_grafana http://grafana:3000;
      proxy_pass         $upstream_grafana;
      proxy_http_version 1.1;
      proxy_set_header   Upgrade           $http_upgrade;
      proxy_set_header   Connection        $connection_upgrade;
      proxy_set_header   Host              $host;
      proxy_set_header   X-Real-IP         $remote_addr;
      proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
      proxy_set_header   X-Forwarded-Proto $scheme;
      proxy_set_header   X-WEBAUTH-USER    $grafana_user;
      proxy_set_header   X-WEBAUTH-ROLE    Admin;
      proxy_read_timeout 300s;
    }

    # ── Wazuh Dashboard ───────────────────────────────────────
    # Dashboard is HTTPS-only with a self-signed cert — proxy over SSL,
    # skip cert hostname check (cert has IP SAN, not DNS name).
    location /wazuh/ {
      auth_request      /auth-check;
      error_page 401 = @sso_login;

      set $upstream_wazuh https://wazuh-dashboard:5601;
      proxy_pass          $upstream_wazuh;
      proxy_http_version  1.1;
      proxy_set_header    Upgrade           $http_upgrade;
      proxy_set_header    Connection        $connection_upgrade;
      proxy_ssl_verify    off;
      proxy_set_header    Host              $host;
      proxy_set_header    X-Real-IP         $remote_addr;
      proxy_set_header    X-Forwarded-For   $proxy_add_x_forwarded_for;
      proxy_set_header    Authorization     $wazuh_basic_auth;
      proxy_read_timeout  300s;
    }

    # ── OpenCTI ───────────────────────────────────────────────
    location /opencti/ {
      auth_request      /auth-check;
      error_page 401 = @sso_login;

      set $upstream_opencti http://opencti:8080;
      proxy_pass         $upstream_opencti;
      proxy_http_version 1.1;
      proxy_set_header   Upgrade           $http_upgrade;
      proxy_set_header   Connection        $connection_upgrade;
      proxy_set_header   Host              $host;
      proxy_set_header   X-Real-IP         $remote_addr;
      proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
      proxy_set_header   X-Forwarded-Proto $scheme;
      proxy_read_timeout 120s;
      proxy_buffering    off;
      proxy_hide_header  X-Frame-Options;
      proxy_hide_header  Content-Security-Policy;
      add_header         X-Frame-Options "SAMEORIGIN";
    }

    # ── Prometheus ────────────────────────────────────────────
    location /prometheus/ {
      auth_request      /auth-check;
      error_page 401 = @sso_login;

      set $upstream_prometheus http://prometheus:9090;
      proxy_pass       $upstream_prometheus/prometheus/;
      proxy_set_header Host              $host;
      proxy_set_header X-Real-IP         $remote_addr;
      proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
    }
  }

  # ── Velociraptor GUI (port 8889, same portal TLS cert) ────────
  # nginx handles TLS here so the browser trusts the same cert as
  # the portal on 443 — no second cert warning.  Basic-auth creds
  # are injected so the user never sees a Velociraptor login prompt.
  # Portal SSO is still required.
  server {
    listen 8889 ssl;
    server_name _;

    ssl_certificate     /etc/nginx/certs/server.crt;
    ssl_certificate_key /etc/nginx/certs/server.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 10m;

    add_header Strict-Transport-Security "max-age=31536000" always;

    location = /auth-check {
      internal;
      proxy_cache            auth_cache;
      proxy_cache_valid      200 2m;
      proxy_cache_key        "$cookie_soc_session$http_authorization";
      proxy_cache_lock       on;
      proxy_ignore_headers   Cache-Control Expires Set-Cookie;
      set $upstream_portal http://soc-portal:4000;
      proxy_pass              $upstream_portal/api/auth/validate;
      proxy_pass_request_body off;
      proxy_set_header        Content-Length "";
      proxy_set_header        X-Original-URI $request_uri;
      proxy_read_timeout      5s;
    }

    location @sso_login {
      return 302 https://$host/login;
    }

    location / {
      auth_request      /auth-check;
      error_page 401  = @sso_login;

      set $upstream_velo https://velociraptor:8889;
      proxy_pass                $upstream_velo;
      proxy_ssl_verify          off;
      proxy_http_version        1.1;
      proxy_set_header          Upgrade                $http_upgrade;
      proxy_set_header          Connection             $connection_upgrade;
      proxy_set_header          Host                   velociraptor;
      proxy_set_header          X-Real-IP              $remote_addr;
      proxy_set_header          X-Forwarded-For        $proxy_add_x_forwarded_for;
      proxy_set_header          X-Forwarded-Proto      $scheme;
      proxy_set_header          Authorization          "Basic ${VELO_BASIC_AUTH_B64}";
      proxy_read_timeout        300s;
      proxy_send_timeout        300s;
      # gRPC-web streaming: disable buffering so frames reach the browser immediately
      proxy_buffering           off;
      proxy_cache               off;
      proxy_request_buffering   off;
    }
  }
