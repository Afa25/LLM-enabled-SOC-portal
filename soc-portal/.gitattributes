# Ensure shell scripts always have LF line endings (required for Linux execution)
*.sh    text eol=lf
*.sh    diff=bash

# PowerShell scripts with CRLF on Windows, LF elsewhere
*.ps1   text eol=crlf

# Config and text files
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.conf  text eol=lf
*.env   text eol=lf
*.md    text eol=lf
