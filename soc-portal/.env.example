# ══════════════════════════════════════════════════════════════
#  SOC PORTAL — ENVIRONMENT CONFIGURATION
#  Copy this file to .env and change all passwords before use
# ══════════════════════════════════════════════════════════════

# ── Wazuh ─────────────────────────────────────────────────────
WAZUH_INDEXER_PASSWORD=SecurePassword1!
WAZUH_API_PASSWORD=SecurePassword1!
WAZUH_DASHBOARD_PASSWORD=SecurePassword1!

# ── Grafana ───────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=SocGrafana1!

# ── OpenVAS ───────────────────────────────────────────────────
OPENVAS_PASSWORD=SecureOpenVAS1!

# ── Ollama LLM ────────────────────────────────────────────────
# Options: llama3.2:3b (fast, 2GB), llama3.1:8b (better, 5GB),
#          mistral:7b (good balance, 4GB), phi3:mini (very fast, 2GB)
OLLAMA_MODEL=llama3.2:3b

# ── SOC Portal ────────────────────────────────────────────────
PORTAL_USER=admin
PORTAL_PASS=SocPortal1!
JWT_SECRET=change-this-to-a-long-random-string-in-production

# ── Network ───────────────────────────────────────────────────
# Network interface for Zeek and Suricata to monitor
SOC_NETWORK_INTERFACE=eth0

# -- Device Monitoring --
# Optional token to allow device heartbeats without JWT.
DEVICE_INGEST_TOKEN=change-this-if-used
# Minutes before a device is considered offline (inventory devices only).
DEVICE_ONLINE_WINDOW_MIN=10

# -- Mobile Pairing --
# Minutes before a pairing code expires.
PAIRING_TTL_MIN=5
# Length of the numeric pairing code.
PAIRING_CODE_LENGTH=6
# Deep link base used to build QR payloads.
PAIRING_DEEPLINK_BASE=soc-portal://pair
