# ============================================================
# SOC Portal — Environment Variables
# Copy this file to .env and fill in ALL values before running.
# NEVER commit .env to version control.
# ============================================================

# ── Portal auth ──────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=change-this-to-a-random-64-char-string

PORTAL_USER=admin
PORTAL_PASS=ChangeThisPortalPassword1!

# ── Wazuh ────────────────────────────────────────────────────
WAZUH_API_PASSWORD=ChangeThisWazuhPassword1!
WAZUH_INDEXER_PASSWORD=ChangeThisIndexerPassword1!
WAZUH_DASHBOARD_PASSWORD=ChangeThisDashboardPassword1!
# Nginx injects this as Basic Auth header when proxying to Wazuh Dashboard.
# Generate: echo -n "admin:ChangeThisWazuhPassword1!" | base64
WAZUH_BASIC_AUTH_B64=YWRtaW46Q2hhbmdlVGhpc1dhenVoUGFzc3dvcmQxIQ==

# TLS: root-ca.pem is mounted from configs/wazuh/certs/ — leave as false.
# Only set to true if the certs directory is missing (first-time setup).
WAZUH_TLS_SKIP_VERIFY=false

# ── Grafana ───────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=ChangeThisGrafanaPassword1!

# ── OpenCTI ───────────────────────────────────────────────────
OPENCTI_ADMIN_EMAIL=admin@soc.local
OPENCTI_ADMIN_PASSWORD=ChangeThisOpenCTI1!
# Must be a valid UUID — generate with: python3 -c "import uuid; print(uuid.uuid4())"
OPENCTI_ADMIN_TOKEN=00000000-0000-0000-0000-000000000000
OPENCTI_RABBITMQ_USER=opencti
OPENCTI_RABBITMQ_PASS=ChangeThisRabbitMQ1!
OPENCTI_MINIO_USER=opencti
OPENCTI_MINIO_PASS=ChangeThisMinio1!

# ── Velociraptor ──────────────────────────────────────────────
# Password set on first boot when the admin user is created.
VELOCIRAPTOR_ADMIN_PASSWORD=ChangeThisVelo1!

# ── Ollama (LLM) ──────────────────────────────────────────────
# Pinned to a fixed model so disk usage stays bounded (~2 GB).
# Do not change to a larger model — the stack is sized for ≤5 GB.
# Docker image is pinned to ollama/ollama:0.4.7 in docker-compose.yml.
OLLAMA_MODEL=llama3.2:3b

# ── Network ───────────────────────────────────────────────────
SOC_NETWORK_INTERFACE=eth0
# Public/LAN IP that remote agents use to reach this server.
# Used to pre-fill enrollment commands in the Agents page.
# Leave blank to auto-detect from the incoming request hostname.
SERVER_IP=
